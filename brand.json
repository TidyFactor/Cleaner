{
  "name": "TidyFactor Cleaner",
  "slug": "tidyfactor-cleaner",
  "tagline": "Universal Developer Environment & System Hygiene Engine",
  "version": "1.3.0",
  "author": "TidyFactor",
  "license": "MIT",
  "decision_gates": [
    {
      "gate_id": "storage_triage",
      "command": "brief",
      "decisions": [
        "target_tiers",
        "confirmation_mode"
      ],
      "discovery": [
        "os_env",
        "drive_free_ratio"
      ],
      "persist_to": ".tidyfactor/cleaner-brief.md",
      "default": "recommended_safe"
    },
    {
      "gate_id": "ide_lock_resolution",
      "command": "ide",
      "decisions": [
        "terminate_locking_daemons"
      ],
      "discovery": [
        "locking_pids"
      ],
      "default": "confirm_before_kill"
    },
    {
      "gate_id": "browser_cache_purge",
      "command": "browser",
      "decisions": [
        "close_browser_if_running"
      ],
      "discovery": [
        "browser_process_state",
        "discovered_profiles"
      ],
      "default": "safe_cache_only"
    }
  ]
}